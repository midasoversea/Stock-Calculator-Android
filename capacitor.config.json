{
  "appId": "com.kridha.stockcalculator",
  "appName": "Stock Calculator",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 300,
      "launchAutoHide": true,
      "backgroundColor": "#17172F",
      "androidSplashResourceName": "stock_splash",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    }
  }
}
